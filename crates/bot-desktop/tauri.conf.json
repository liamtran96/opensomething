{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opensomething",
  "identifier": "dev.opensomething.desktop",
  "build": {
    "frontendDist": "./ui/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "pnpm run dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm run build",
      "cwd": "ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "opensomething",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
