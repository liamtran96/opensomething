{
  "name": "opensomething-ui",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "theme:build": "astryx theme build ./src/themes/brand.ts --out ./src/themes/built/brand.css",
    "theme:check": "astryx theme build ./src/themes/brand.ts --out ./src/themes/built/brand.css --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tauri": "cd .. && tauri"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "0.19.2",
    "@tauri-apps/api": "2.12.5",
    "lucide-react": "0.539.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin": "2.3.11",
    "vite": "7.3.8"
  }
}
